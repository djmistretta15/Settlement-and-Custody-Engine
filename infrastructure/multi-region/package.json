{
  "name": "@settlement-engine/multi-region",
  "version": "1.0.0",
  "description": "Multi-region deployment and failover management for Settlement and Custody Engine",
  "main": "dist/failover-manager.js",
  "types": "dist/failover-manager.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "dev": "ts-node failover-manager.ts",
