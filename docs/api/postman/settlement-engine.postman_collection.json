            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Operations Wallet\",\n    \"scheme\": \"gg18\",\n    \"threshold\": 2,\n    \"participants\": 3,\n    \"participantIds\": [\n        \"ops-signer-1\",\n        \"ops-signer-2\",\n        \"ops-signer-3\"\n    ],\n    \"policy\": {\n        \"maxTransactionAmount\": \"10000000000000000000\",\n        \"dailyLimit\": \"50000000000000000000\",\n        \"requireKYC\": true\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/custody/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["custody", "wallets"]
            },
            "description": "Create custody wallet with GG18 threshold signatures (ECDSA)"
