    {
      "name": "GraphQL",
      "item": [
        {
          "name": "Query Settlements",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetSettlements($filter: SettlementFilter, $pagination: PaginationInput) {\n  settlements(filter: $filter, pagination: $pagination) {\n    edges {\n      node {\n        id\n        sender\n        receiver\n        amount\n        chain\n        status\n        finality {\n          status\n          finalityType\n          timeToFinality\n        }\n        createdAt\n        finalizedAt\n      }\n    }\n    totalCount\n    aggregates {\n      totalVolumeUsd\n      successRate\n    }\n  }\n}",
                "variables": "{\n  \"filter\": {\n    \"status\": [\"FINALIZED\"],\n    \"chain\": [\"ETHEREUM\"]\n  },\n  \"pagination\": {\n    \"first\": 10\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "GraphQL query for settlements with filtering"
          },
          "response": []
        },
        {
          "name": "Query L2 Stats",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetL2Stats {\n  l2NetworkStats {\n    networks {\n      network\n      currentGasPrice\n      avgBlockTime\n      transactions24h\n      volume24hUsd\n      successRate\n    }\n    totalTransactions24h\n    totalVolume24hUsd\n    averageGasSavingsPercent\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "GraphQL query for L2 network statistics"
          },
          "response": []
        },
        {
          "name": "Mutation Create Settlement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateSettlement($input: CreateSettlementInput!) {\n  createSettlement(input: $input) {\n    id\n    sender\n    receiver\n    amount\n    chain\n    status\n    createdAt\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"sender\": \"0x742d35Cc6634C0532925a3b844Bc9e7595f3fbb6\",\n    \"receiver\": \"0x8ba1f109551bD432803012645Ac136ddd64DBA72\",\n    \"amount\": \"1000000000000000000\",\n    \"chain\": \"ETHEREUM\",\n    \"mevProtection\": true\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "GraphQL mutation to create settlement"
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Add request timestamp for debugging",
          "pm.request.headers.add({",
          "    key: 'X-Request-Time',",
          "    value: new Date().toISOString()",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test for all requests",
          "pm.test('Response time is acceptable', () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test('Content-Type is JSON', () => {",
          "    pm.response.to.have.header('Content-Type', /application\\/json/);",
          "});"
        ]
      }
    }
  ]
}
