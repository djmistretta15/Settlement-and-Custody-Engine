              "raw": "{\n    \"sender\": \"0x742d35Cc6634C0532925a3b844Bc9e7595f3fbb6\",\n    \"receiver\": \"0x8ba1f109551bD432803012645Ac136ddd64DBA72\",\n    \"amount\": \"50000000000000000000\",\n    \"chain\": \"ethereum\",\n    \"settlementType\": \"atomic\",\n    \"mevProtection\": true,\n    \"priorityLevel\": \"high\"\n}"
