  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-rds": "^3.400.0",
    "@aws-sdk/client-globalaccelerator": "^3.400.0",
    "@aws-sdk/client-route-53": "^3.400.0",
    "@aws-sdk/client-eks": "^3.400.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-node": "^10.9.0"
  }
}
