# Settlement and Custody Engine - Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# Network Configuration
# ========================================

# Testnet RPC URLs (get free keys from Infura or Alchemy)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MUMBAI_RPC_URL=https://polygon-mumbai.infura.io/v3/YOUR_INFURA_KEY
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY

# Mainnet RPC URLs (for production only)
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# ========================================
# Wallet Configuration
# ========================================

# Private key for deployment (testnet only - NEVER use mainnet keys here)
# Get testnet ETH from: https://sepoliafaucet.com/
PRIVATE_KEY=your_testnet_private_key_here

# Alternative: Use mnemonic instead of private key
# MNEMONIC=your twelve word seed phrase here

# Deployer address (optional - derived from private key)
DEPLOYER_ADDRESS=0x...

# ========================================
# Contract Verification
# ========================================

# Etherscan API key for contract verification
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key

# Polygonscan API key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Arbiscan API key
ARBISCAN_API_KEY=your_arbiscan_api_key

# ========================================
# API Configuration
# ========================================

# API Server Port
API_PORT=3000

# API Base URL (for production)
API_URL=https://api.settlement-engine.io

# API Keys (generate random secure strings)
API_KEY=generate_random_api_key_here
API_SECRET=generate_random_secret_here

# JWT Secret for authentication
JWT_SECRET=generate_random_jwt_secret_here

# ========================================
# Security Configuration
# ========================================

# Enable two-factor authentication
ENABLE_2FA=true

# Session timeout in seconds (default: 1 hour)
SESSION_TIMEOUT=3600

# Rate limiting
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# Custody Configuration
# ========================================

# Default time-lock delay in seconds (24 hours)
DEFAULT_TIMELOCK_DELAY=86400

# Minimum time-lock delay in seconds (1 hour)
MIN_TIMELOCK_DELAY=3600

# Required signatures for withdrawals
REQUIRED_SIGNATURES=3

# ========================================
# Settlement Configuration
# ========================================

# Settlement timeout in seconds
SETTLEMENT_TIMEOUT=3600

# Minimum attestations required
MIN_ATTESTATIONS=2

# Fraud proof window in seconds
FRAUD_PROOF_WINDOW=3600

# ========================================
# Compliance Configuration
# ========================================

# KYC verification endpoint (if using external service)
KYC_VERIFICATION_URL=https://kyc-provider.com/api/verify

# OFAC screening endpoint
OFAC_SCREENING_URL=https://ofac-provider.com/api/screen

# Travel Rule threshold in USD
TRAVEL_RULE_THRESHOLD=1000

# ========================================
# Monitoring & Logging
# ========================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable verbose logging
VERBOSE=false

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ========================================
# Database (if using off-chain storage)
# ========================================

# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/settlement_engine

# Redis for caching and rate limiting
REDIS_URL=redis://localhost:6379

# ========================================
# External Services
# ========================================

# ZK Proof generation service (if using external)
ZK_PROOF_SERVICE_URL=https://zk-proof-service.com/api

# Price oracle for asset valuation
ORACLE_URL=https://api.coingecko.com/api/v3

# ========================================
# Development/Testing
# ========================================

# Network to use (hardhat, sepolia, mainnet)
NETWORK=sepolia

# Enable gas reporting in tests
REPORT_GAS=false

# Enable test coverage
COVERAGE=false

# Run tests in forked mode
FORK_ENABLED=false
FORK_BLOCK_NUMBER=latest

# ========================================
# Production Settings
# ========================================

# Node environment (development, staging, production)
NODE_ENV=development

# Enable SSL/TLS
ENABLE_SSL=false

# SSL certificate paths
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://app.settlement-engine.io

# ========================================
# Notes
# ========================================

# 1. NEVER commit this file with real values to git
# 2. Use different keys for testnet and mainnet
# 3. Store production secrets in secure key management (AWS Secrets Manager, Vault, etc.)
# 4. Rotate API keys and secrets regularly
# 5. Use hardware wallets for mainnet deployments
# 6. Enable MFA for all production accounts
