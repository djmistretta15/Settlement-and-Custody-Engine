        {
          "name": "Get Settlement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Settlement retrieved', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response).to.have.property('status');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/settlements/{{settlementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["settlements", "{{settlementId}}"]
            },
            "description": "Retrieve settlement details by ID"
          },
          "response": []
        },
        {
          "name": "List Settlements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/settlements?status=pending&chain=ethereum&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["settlements"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "chain",
                  "value": "ethereum"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "List settlements with filtering and pagination"
          },
          "response": []
        },
        {
          "name": "Get Settlement Finality",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/settlements/{{settlementId}}/finality",
              "host": ["{{baseUrl}}"],
              "path": ["settlements", "{{settlementId}}", "finality"]
            },
            "description": "Get cross-chain finality verification status"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Custody",
      "item": [
        {
          "name": "Create FROST Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "    pm.collectionVariables.set('walletId', response.id);",
                  "}",
                  "",
                  "pm.test('FROST wallet created', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(response.scheme).to.equal('frost');",
                  "    pm.expect(response.threshold).to.equal(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Treasury Main Wallet\",\n    \"scheme\": \"frost\",\n    \"threshold\": 3,\n    \"participants\": 5,\n    \"participantIds\": [\n        \"signer-alice\",\n        \"signer-bob\",\n        \"signer-charlie\",\n        \"signer-dave\",\n        \"signer-eve\"\n    ],\n    \"policy\": {\n        \"maxTransactionAmount\": \"100000000000000000000\",\n        \"dailyLimit\": \"1000000000000000000000\",\n        \"allowedDestinations\": [\"0x*\"],\n        \"blockedDestinations\": [],\n        \"requireKYC\": true,\n        \"requireApproval\": false\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/custody/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["custody", "wallets"]
            },
            "description": "Create custody wallet with FROST threshold signatures (Schnorr)"
          },
          "response": []
        },
        {
          "name": "Create GG18 Wallet",
          "request": {
            "method": "POST",
            "header": [
