            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/custody/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["custody", "wallets"]
            },
            "description": "List all custody wallets"
          },
          "response": []
        },
        {
          "name": "Request Signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.sessionId) {",
                  "    pm.collectionVariables.set('sessionId', response.sessionId);",
                  "}",
                  "",
                  "pm.test('Signature session created', () => {",
                  "    pm.response.to.have.status(202);",
                  "    pm.expect(response.status).to.equal('pending');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"0x4d7920746573742074782e\",\n    \"transaction\": {\n        \"to\": \"0x8ba1f109551bD432803012645Ac136ddd64DBA72\",\n        \"value\": \"1000000000000000000\",\n        \"data\": \"0x\",\n        \"gasLimit\": \"21000\",\n        \"nonce\": 1\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/custody/wallets/{{walletId}}/sign",
              "host": ["{{baseUrl}}"],
              "path": ["custody", "wallets", "{{walletId}}", "sign"]
